diff --git a/bin/lib/launcher.js b/bin/lib/launcher.js
index dc5c667..fa8686d 100644
--- a/bin/lib/launcher.js
+++ b/bin/lib/launcher.js
@@ -243,7 +243,8 @@ export async function runLauncher(args = process.argv.slice(2)) {
     await spawnSenpi(args, false)
     return
   }
-  if (isInteractiveDefault(args)) {
+  // omo-mini launches this engine under its own identity; the omo-ai beta banner is not its product.
+  if (isInteractiveDefault(args) && process.env.OMO_MINI_LOCAL_PROFILE !== "1") {
     console.error(`omo (omo-ai beta ${packageManifest().version})`)
     if (process.stdout.isTTY === true && setupSuggestionForLaunch()) {
       console.error("omo: sibling credentials detected; run `omo setup` to review them")
diff --git a/bin/lib/package-paths.js b/bin/lib/package-paths.js
index 7fc5050..5ab8c4c 100644
--- a/bin/lib/package-paths.js
+++ b/bin/lib/package-paths.js
@@ -51,7 +51,8 @@ export function resolveSenpi(options = {}) {
   // launcher change.
   const bundlePath = join(distDir, "bundle", "cli.js")
   const unbundledPath = join(distDir, "cli.js")
-  const cliPath = existsSync(bundlePath) ? bundlePath : unbundledPath
+  // omo-mini: use Senpi's patchable module graph; the pre-linked bundle embeds an unpatched runner.
+  const cliPath = unbundledPath
   if (!existsSync(cliPath)) {
     throw new Error(`senpi CLI is missing at ${cliPath}; reinstall with: ${updateTarget().command}`)
   }
